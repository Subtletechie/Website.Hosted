<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'">
<meta name="referrer" content="no-referrer">
<title>{{ v.run.client }} · Security Assessment</title>
<link rel="icon" href="{{ logo }}">
<style>
:root { --accent: {{ brand.accent }}; }
{{ css | safe }}
</style>
</head>
<body>
<header class="topbar">
  <div class="topbar-inner">
    <div class="brand">
      <img src="{{ logo }}" alt="" width="32" height="32">
      <div>
        <div class="brand-name">{{ brand.name }}</div>
        <div class="brand-tag">{{ brand.tagline }}</div>
      </div>
    </div>
    <div class="client">
      <div class="client-name">{{ v.run.client }}</div>
      <div class="client-meta">{{ v.run.provider.value | upper }} · scanned {{ v.run.started_at | date }}</div>
    </div>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Toggle light or dark theme">
      <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
    </button>
  </div>
  <nav class="tabs" aria-label="Sections">
    <a href="#overview" data-tab="overview">Overview</a>
    <a href="#findings" data-tab="findings">Findings <span class="tab-count">{{ v.open_findings | length }}</span></a>
  </nav>
</header>

<main>
{% include "_overview.html.j2" %}
{% include "_findings.html.j2" %}
</main>

<footer class="footer">
  <p><strong>Private by design.</strong> This assessment was read-only and generated entirely on the assessor's machine.
  No hosting, no logins, no tracking: this {{ "page" if mode == "live" else "file" }} makes no network requests and your data never left the room.</p>
  <p class="muted">subtlescan {{ v.run.tool_version }} · {{ brand.name }}{% if brand.contact %} · {{ brand.contact }}{% endif %}</p>
</footer>
<script>
{{ js | safe }}
</script>
</body>
</html>
